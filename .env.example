# ==============================================================================
# CLASSVAULT PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# DO NOT commit .env or secrets to version control.
# ==============================================================================

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL Connection
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC / URI
# Format: jdbc:postgresql://<db-host>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://db.rxopgndwccjgnyumbgvz.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# JWT Secret Key (Base64 or 256-bit Hex string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Server Port
SERVER_PORT=8080
