# ==============================================================================
# CLASSVAULT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env and fill in your Supabase database credentials.
# NEVER commit your real .env file or production secrets to Git.
# ==============================================================================

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL Connection
# Format: jdbc:postgresql://<db-host>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# JWT Secret Key (Base64 or 256-bit Hex string)
JWT_SECRET=

# Server Port
SERVER_PORT=8080
